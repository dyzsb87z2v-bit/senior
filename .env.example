# ─────────────────────────────────────────────────────────────────────────────
# Mittagessen-Service — server environment. Copy to .env; never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# The address the public (and Twilio) reaches the app on. Must be https:// in production.
PUBLIC_URL=http://localhost:3000
# Domain for docker-compose's Caddy (automatic HTTPS), e.g. mittag.example.de. PUBLIC_URL is then https://<DOMAIN>.
DOMAIN=localhost

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/senior_lunch

# Sessions: a random secret of at least 32 characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Requests per minute per IP (all tablets of the restaurant may share one address), and login attempts per minute per IP.
RATE_LIMIT_PER_MINUTE=1200
LOGIN_RATE_LIMIT=10

# First admin account, used by `npm run db:seed` only when no user exists yet.
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=
# SEED_SAMPLE=true also creates three sample customers (427, 315, 108) and today's sample menu.
SEED_SAMPLE=false

# Twilio Programmable Voice — telephony, German speech-to-text, text-to-speech.
# Auth token of the Twilio account: verifies X-Twilio-Signature on every webhook. REQUIRED for calls.
TWILIO_AUTH_TOKEN=
# The Twilio number (E.164), shown as caller id when handing a call to the restaurant. Optional.
TWILIO_PHONE_NUMBER=

# Fable (Claude Fable 5.1) — German language understanding for natural sentences.
# Optional: without a key only the rule-based understanding runs (menu numbers, dish names,
# yes/no, "wie gestern") and free-form sentences are asked again.
ANTHROPIC_API_KEY=
LUNCH_AI_MODEL=claude-fable-5-1
# Hard timeout for one model call in ms; Twilio waits 15 s for the webhook.
LUNCH_AI_TIMEOUT_MS=9000

# Human handoff: the restaurant's phone number (E.164). Einstellungen → Telefonnummer für Weiterleitung takes precedence.
LUNCH_HANDOFF_NUMBER=

# Text-to-speech voice for Twilio <Say>. "Polly.Vicki-Neural" if the account has neural voices.
LUNCH_TTS_VOICE=Polly.Vicki

# Only when the URL configured in Twilio differs from PUBLIC_URL + /api/voice/twilio (e.g. a tunnel):
# LUNCH_PUBLIC_VOICE_URL=
# LUNCH_PUBLIC_STATUS_URL=

# Development only. Never true in production (the server refuses to start).
LUNCH_ALLOW_UNSIGNED_WEBHOOKS=false

LOG_LEVEL=info
